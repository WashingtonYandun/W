## 05_utf8_and_algorithms.wysna
## UTF-8 code-point semantics and classic algorithms in Wysna.

fn binary_search(items: list[int], target: int) -> int? {
    let mut low = 0
    let mut high = len(items) - 1

    while low <= high {
        let mid = (low + high) / 2
        let val = items[mid]
        if val == target {
            return mid
        } elif val < target {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return none
}

fn main() -> unit {
    let word = "José"
    print("String:", word)
    print("Code points (len):", len(word))
    print("4th code point (word[3]):", word[3])
    print("UTF-8 byte count:", len(bytes(word)))

    let sorted_nums = [2, 5, 8, 12, 16, 23, 38, 56, 72, 91]
    print("Index of 23:", binary_search(sorted_nums, 23) ?? -1)
    print("Index of 42:", binary_search(sorted_nums, 42) ?? -1)
}
