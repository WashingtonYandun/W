## 01_hello_world.wysna
## Basic functions, type annotations, ranges, and loops in Wysna v0.5.0.

fn greet(name: str) -> str {
    return "Hello, " + name + "! Welcome to Wysna v0.5.0."
}

fn sum_range(limit: int) -> int {
    let mut total = 0
    for i in 1..=limit {
        total = total + i
    }
    return total
}

fn main() -> unit {
    print(greet("Washo"))
    print("Sum 1..=10:", sum_range(10))
    print("Sum 1..=100:", sum_range(100))
}
