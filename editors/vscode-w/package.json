{
  "name": "w-lang",
  "displayName": "W Programming Language",
  "description": "Syntax highlighting and language configuration for the W Programming Language (v0.1)",
  "version": "0.1.0",
  "publisher": "washingtonyandun",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "w",
        "aliases": ["W", "w"],
        "extensions": [".w"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "w",
        "scopeName": "source.w",
        "path": "./syntaxes/w.tmLanguage.json"
      }
    ]
  }
}
