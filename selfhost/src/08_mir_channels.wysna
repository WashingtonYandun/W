# Result channels use explicit branches; payload helpers borrow and return owned values.
fn mir_pack(value: int, type_id: int, error: bool, source: Token) -> int {
    return mir_op("runtime", type_id, [value], if error { "wysna_err" } else { "wysna_ok" }, mir_literal_unit(), source)
}

fn mir_error_test(value: int, source: Token) -> int {
    let predicate = mir_op("test", 2, [value], "err", mir_literal_unit(), source)
    mir_slots[predicate].predicate = true
    return predicate
}

fn mir_coerce(value: int, target: int, discard: bool, source: Token) -> int {
    let actual = mir_slots[value].type_id
    if actual == target { return value }
    if mir_is_result(target) {
        let ok = mir_result_types[target - 7].ok
        if actual == ok { return mir_pack(value, target, false, source) }
        if discard and ok == 1 {
            if mir_is_result(actual) {
                let result = mir_slot(target, "", false)
                let condition = mir_error_test(value, source)
                let failed = mir_new_block(source)
                let succeeded = mir_new_block(source)
                let join = mir_new_block(source)
                mir_terminate("branch", [failed, succeeded], condition, source)
                mir_current = failed
                let error = mir_op("runtime", 5, [value], "wysna_unwrap_err", mir_literal_unit(), source)
                let wrapped = mir_pack(error, target, true, source)
                mir_store(result, wrapped, source)
                mir_jump(join, source)
                mir_current = succeeded
                let unit = mir_constant(mir_literal_unit(), 1, source)
                let success = mir_pack(unit, target, false, source)
                mir_store(result, success, source)
                mir_jump(join, source)
                mir_current = join
                return result
            }
            let unit = mir_constant(mir_literal_unit(), 1, source)
            return mir_pack(unit, target, false, source)
        }
    }
    report_error_at("W9999", source, "unsupported checked MIR coercion")
    return -1
}

fn mir_channel(value: int, source: Token, propagate: bool) -> int {
    let channel = mir_slots[value].type_id
    if not mir_is_result(channel) { mir_unsupported(source, "non-result channels") }
    let ok = mir_result_types[channel - 7].ok
    let result = mir_slot(ok, "", false)
    let condition = mir_error_test(value, source)
    let failed = mir_new_block(source)
    let succeeded = mir_new_block(source)
    let join = mir_new_block(source)
    mir_terminate("branch", [failed, succeeded], condition, source)
    mir_current = failed
    if propagate {
        if not mir_is_result(mir_return_type) { report_error_at("W9999", source, "propagation requires a checked result return") }
        let error = mir_op("runtime", 5, [value], "wysna_unwrap_err", mir_literal_unit(), source)
        let returned = mir_pack(error, mir_return_type, true, source)
        mir_return(returned, source)
    } else {
        let bindings = mir_bindings
        mir_push_scope()
        if check_kind("IDENT") {
            let name = advance_tok().val
            let error = mir_op("runtime", 5, [value], "wysna_unwrap_err", mir_literal_unit(), source)
            mir_bindings.append(MirBinding { name: name, slot: error, mutable: false })
        }
        let fallback = mir_block()
        if mir_current >= 0 {
            let checked = mir_coerce(fallback, ok, false, source)
            mir_store(result, checked, source)
            mir_cleanup(len(mir_scopes) - 1, source)
            mir_jump(join, source)
        }
        mir_scopes.pop()
        mir_bindings = bindings
    }
    mir_current = succeeded
    let unwrapped = mir_op("runtime", ok, [value], "wysna_unwrap_ok", mir_literal_unit(), source)
    mir_store(result, unwrapped, source)
    mir_jump(join, source)
    mir_current = join
    return result
}
