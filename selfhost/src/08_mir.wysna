# Backend-independent typed CFG and ownership data.
struct MirLiteral { type_id: int, integer: int, floating: float, boolean: bool, text: str }
struct MirSlot { type_id: int, name: str, parameter: bool, origin: int, predicate: bool }
struct MirOperation { opcode: str, result: int, args: list[int], name: str, value: MirLiteral, source: Token }
struct MirTerminator { kind: str, targets: list[int], value: int, source: Token }
struct MirBlock { operations: list[MirOperation], terminator: MirTerminator }
struct MirFunction { name: str, return_type: int, slots: list[MirSlot], blocks: list[MirBlock], params: list[int], source: Token }
struct MirBinding { name: str, slot: int, mutable: bool }
struct MirScope { slots: list[int] }
struct MirLoop { after: int, header: int, depth: int }
struct MirState { seen: bool, defined: list[bool], live: list[bool], facts: list[int] }
struct MirResultType { ok: int, error: int }
let mut mir_result_types: list[MirResultType] = []

let mut mir_functions: list[MirFunction] = []
let mut mir_slots: list[MirSlot] = []
let mut mir_blocks: list[MirBlock] = []
let mut mir_params: list[int] = []
let mut mir_bindings: list[MirBinding] = []
let mut mir_scopes: list[MirScope] = []
let mut mir_loops: list[MirLoop] = []
let mut mir_current = -1
let mut mir_return_type = 1

fn mir_literal_unit() -> MirLiteral { return MirLiteral { type_id: 1, integer: 0, floating: 0.0, boolean: false, text: "" } }
fn mir_literal_bool(value: bool) -> MirLiteral { return MirLiteral { type_id: 2, integer: 0, floating: 0.0, boolean: value, text: "" } }
fn mir_literal_int(value: int) -> MirLiteral { return MirLiteral { type_id: 3, integer: value, floating: 0.0, boolean: false, text: "" } }
fn mir_literal_float(value: float) -> MirLiteral { return MirLiteral { type_id: 4, integer: 0, floating: value, boolean: false, text: "" } }

fn mir_literal_str(value: str) -> MirLiteral {
    return MirLiteral { type_id: 5, integer: 0, floating: 0.0, boolean: false, text: value }
}

fn mir_value_storage(type_id: int) -> bool { return type_id == 1 or type_id == 5 or type_id >= 7 }

fn mir_unsupported(token: Token, feature: str) {
    report_error_at("W2013", token, "Compiler MIR result-cfg-v1 does not support " + feature)
}

fn mir_expect(kind: str) -> Token {
    if not check_kind(kind) { mir_unsupported(at_tok(), "token " + at_tok().kind + " here (expected " + kind + ")") }
    return advance_tok()
}

fn mir_type(type_id: int, source: Token) -> int {
    let kind = sem_kind(type_id)
    if kind == "unit" { return 1 }
    if kind == "bool" { return 2 }
    if kind == "int" { return 3 }
    if kind == "float" { return 4 }
    if kind == "str" { return 5 }
    if kind == "result" {
        let args_ = sem_types[type_id].args
        let ok = mir_type(args_[0], source)
        let error = mir_type(args_[1], source)
        if ok > 5 or error != 5 { mir_unsupported(source, "nested results or non-string error channels") }
        for i in 0..len(mir_result_types) { if mir_result_types[i].ok == ok and mir_result_types[i].error == error { return i + 7 } }
        mir_result_types.append(MirResultType { ok: ok, error: error })
        return len(mir_result_types) + 6
    }
    mir_unsupported(source, "type " + kind)
    return 0
}

fn mir_valid_type(type_id: int) -> bool {
    return type_id >= 1 and type_id <= 5 or type_id >= 7 and type_id < len(mir_result_types) + 7
}

fn mir_is_result(type_id: int) -> bool { return type_id >= 7 and type_id < len(mir_result_types) + 7 }

fn mir_consumes(operation: MirOperation) -> bool {
    return operation.opcode == "store" or operation.opcode == "runtime" and (operation.name == "wysna_ok" or operation.name == "wysna_err")
}

fn mir_checked_fact(facts: list[SemMirFact], position: int, source: Token) -> int {
    for fact in facts { if fact.position == position + 1 { return mir_type(fact.type_id, source) } }
    report_error_at("W9999", source, "missing checked MIR type fact")
    return -1
}

fn mir_new_block(source: Token) -> int {
    let operations: list[MirOperation] = []
    let targets: list[int] = []
    let terminator = MirTerminator { kind: "", targets: targets, value: -1, source: source }
    let id = len(mir_blocks)
    mir_blocks.append(MirBlock { operations: operations, terminator: terminator })
    return id
}

fn mir_push_scope() {
    let slots: list[int] = []
    mir_scopes.append(MirScope { slots: slots })
}

fn mir_begin(source: Token, returned: int) {
    let slots: list[MirSlot] = []
    let blocks: list[MirBlock] = []
    let params: list[int] = []
    let bindings: list[MirBinding] = []
    let scopes: list[MirScope] = []
    let loops: list[MirLoop] = []
    mir_slots = slots
    mir_blocks = blocks
    mir_params = params
    mir_bindings = bindings
    mir_scopes = scopes
    mir_loops = loops
    mir_return_type = returned
    mir_push_scope()
    mir_current = mir_new_block(source)
}

fn mir_raw_slot(type_id: int, name: str, parameter: bool) -> int {
    let id = len(mir_slots)
    mir_slots.append(MirSlot { type_id: type_id, name: name, parameter: parameter, origin: -1, predicate: false })
    if parameter { mir_params.append(id) }
    return id
}

fn mir_track(id: int) {
    if mir_value_storage(mir_slots[id].type_id) and not mir_slots[id].parameter {
        mir_scopes[len(mir_scopes) - 1].slots.append(id)
    }
}

fn mir_slot(type_id: int, name: str, parameter: bool) -> int {
    let id = mir_raw_slot(type_id, name, parameter)
    mir_track(id)
    return id
}

fn mir_append(operation: MirOperation) {
    if mir_current < 0 { report_error_at("W9999", operation.source, "MIR emission requires a live block") }
    mir_blocks[mir_current].operations.append(operation)
}

fn mir_op(opcode: str, type_id: int, args_: list[int], name: str, value: MirLiteral, source: Token) -> int {
    let id = mir_slot(type_id, "", false)
    mir_append(MirOperation { opcode: opcode, result: id, args: args_, name: name, value: value, source: source })
    return id
}

fn mir_store(destination: int, value: int, source: Token) {
    mir_append(MirOperation { opcode: "store", result: destination, args: [value], name: "", value: mir_literal_unit(), source: source })
}

fn mir_constant(value: MirLiteral, type_id: int, source: Token) -> int {
    let empty: list[int] = []
    return mir_op("const", type_id, empty, "", value, source)
}

fn mir_release(id: int, source: Token) {
    if mir_value_storage(mir_slots[id].type_id) and not mir_slots[id].parameter {
        mir_append(MirOperation { opcode: "release", result: -1, args: [id], name: "", value: mir_literal_unit(), source: source })
    }
}

fn mir_cleanup(depth: int, source: Token) {
    let mut scope = len(mir_scopes) - 1
    while scope >= depth {
        let slots = mir_scopes[scope].slots
        let mut index = len(slots) - 1
        while index >= 0 { mir_release(slots[index], source) index = index - 1 }
        scope = scope - 1
    }
}

fn mir_terminate(kind: str, targets: list[int], value: int, source: Token) {
    if mir_current < 0 { report_error_at("W9999", source, "MIR block already terminated") }
    mir_blocks[mir_current].terminator = MirTerminator { kind: kind, targets: targets, value: value, source: source }
    mir_current = -1
}

fn mir_jump(target: int, source: Token) { mir_terminate("goto", [target], -1, source) }

fn mir_return(value: int, source: Token) {
    if mir_current < 0 { return }
    let checked = mir_coerce(value, mir_return_type, true, source)
    let escaped = mir_raw_slot(mir_return_type, "", false)
    mir_store(escaped, checked, source)
    mir_cleanup(0, source)
    let targets: list[int] = []
    mir_terminate("return", targets, escaped, source)
}

fn mir_finish(name: str, source: Token) {
    let targets: list[int] = []
    for i in 0..len(mir_blocks) {
        if mir_blocks[i].terminator.kind == "" {
            mir_blocks[i].terminator = MirTerminator { kind: "unreachable", targets: targets, value: -1, source: source }
        }
    }
    mir_functions.append(MirFunction { name: name, return_type: mir_return_type, slots: mir_slots, blocks: mir_blocks, params: mir_params, source: source })
}

fn mir_integer(text: str, negative: bool, source: Token) -> int {
    let mut start = 0
    while start + 1 < len(text) and text[start] == "0" { start = start + 1 }
    let digits = slice(text, start, len(text))
    let limit = if negative { "9223372036854775808" } else { "9223372036854775807" }
    let mut too_large = len(digits) > len(limit)
    if len(digits) == len(limit) {
        for i in 0..len(limit) {
            if ord(digits[i]) > ord(limit[i]) { too_large = true break }
            if ord(digits[i]) < ord(limit[i]) { break }
        }
    }
    if too_large { report_error_at("W0002", source, "integer literal is outside signed int64 range") }
    let number = int(if negative { "-" + digits } else { digits })
    return mir_constant(mir_literal_int(number), 3, source)
}

fn mir_quote(text: str) -> str {
    let hex = "0123456789abcdef"
    let mut quoted = "\""
    for i in 0..len(text) {
        let ch = text[i]
        let code = ord(ch)
        if ch == "\"" { quoted = quoted + "\\\"" }
        elif ch == "\\" { quoted = quoted + "\\\\" }
        elif code < 32 { quoted = quoted + "\\u00" + hex[code / 16] + hex[code % 16] }
        else { quoted = quoted + ch }
    }
    return quoted + "\""
}

fn mir_source_json(source: Token) -> str {
    return "{\"$type\":\"Source\",\"file\":" + mir_quote(source.file) + ",\"line\":" + str(source.line) + ",\"col\":" + str(source.col) + "}"
}

fn mir_ids(ids: list[int], tuple_: bool) -> str {
    let mut result = "["
    for i in 0..len(ids) { if i > 0 { result = result + "," } result = result + str(ids[i]) }
    result = result + "]"
    if tuple_ { return "{\"$tuple\":" + result + "}" }
    return result
}

fn mir_literal_json(value: MirLiteral) -> str {
    if value.type_id == 1 { return "null" }
    if value.type_id == 2 { return str(value.boolean) }
    if value.type_id == 3 { return str(value.integer) }
    if value.type_id == 5 { return mir_quote(value.text) }
    return str(value.floating)
}

fn mir_operation_json(operation: MirOperation) -> str {
    let mut data = "{}"
    let mut effect = "call"
    let mut result = str(operation.result)
    let mut moves: list[int] = []
    if operation.opcode == "const" { effect = "pure" data = "{\"value\":" + mir_literal_json(operation.value) + "}" }
    elif operation.opcode == "clone" { effect = "retain" }
    elif operation.opcode == "store" { effect = "move" moves = [0] }
    elif operation.opcode == "release" { effect = "release" result = "null" }
    elif operation.opcode == "test" { effect = "read" data = "{\"kind\":\"err\"}" }
    else {
        if mir_consumes(operation) { moves = [0] }
        data = "{\"name\":" + mir_quote(operation.name)
        if operation.name == "wysna_div_at" or operation.name == "wysna_mod_at" or operation.name == "wysna_index_get_owned_at" { data = data + ",\"source\":true" }
        data = data + "}"
    }
    return "{\"$type\":\"Operation\",\"opcode\":" + mir_quote(operation.opcode) + ",\"result\":" + result + ",\"args\":" + mir_ids(operation.args, true) + ",\"data\":" + data + ",\"moves\":" + mir_ids(moves, true) + ",\"effect\":" + mir_quote(effect) + ",\"source\":" + mir_source_json(operation.source) + "}"
}

fn mir_function_json(function: MirFunction) -> str {
    let mut slots = "["
    for i in 0..len(function.slots) {
        if i > 0 { slots = slots + "," }
        let slot = function.slots[i]
        let mut storage = "value"
        if slot.type_id == 2 { storage = if slot.predicate { "predicate" } else { "boolean" } }
        elif slot.type_id == 3 { storage = "integer" }
        elif slot.type_id == 4 { storage = "float" }
        let ownership = if slot.parameter { "borrowed" } else { "owned" }
        slots = slots + "{\"$type\":\"Slot\",\"id\":" + str(i) + ",\"type_id\":" + str(slot.type_id) + ",\"name\":" + mir_quote(slot.name) + ",\"storage\":" + mir_quote(storage) + ",\"ownership\":" + mir_quote(ownership) + ",\"parameter\":" + str(slot.parameter) + "}"
    }
    slots = slots + "]"
    let mut blocks = "["
    for i in 0..len(function.blocks) {
        if i > 0 { blocks = blocks + "," }
        let block = function.blocks[i]
        let mut operations = "["
        for j in 0..len(block.operations) {
            if j > 0 { operations = operations + "," }
            operations = operations + mir_operation_json(block.operations[j])
        }
        operations = operations + "]"
        let terminator = block.terminator
        let value = if terminator.value < 0 { "null" } else { str(terminator.value) }
        let term = "{\"$type\":\"Terminator\",\"kind\":" + mir_quote(terminator.kind) + ",\"targets\":" + mir_ids(terminator.targets, true) + ",\"value\":" + value + ",\"source\":" + mir_source_json(terminator.source) + "}"
        blocks = blocks + "{\"$type\":\"BasicBlock\",\"id\":" + str(i) + ",\"operations\":" + operations + ",\"terminator\":" + term + "}"
    }
    return "{\"$type\":\"Function\",\"name\":" + mir_quote(function.name) + ",\"return_type\":" + str(function.return_type) + ",\"slots\":" + slots + ",\"blocks\":" + blocks + "],\"params\":" + mir_ids(function.params, false) + ",\"source\":" + mir_source_json(function.source) + "}"
}

fn mir_arena_json() -> str {
    # Reserved TypeIds and capabilities are the wysna.mir/1 contract.
    let names: list[str] = ["", "unit", "bool", "int", "float", "str", "none"]
    let mut entries = "[{\"tag\":\"error\",\"data\":null}"
    let mut capabilities = "["
    for i in 0..len(names) {
        if i > 0 {
            entries = entries + ",{\"tag\":\"primitive\",\"data\":" + mir_quote(names[i]) + "}"
            capabilities = capabilities + ","
        }
        let retain = str(i == 5)
        let key = str(i == 2 or i == 3 or i == 5)
        capabilities = capabilities + "{\"needs_retain\":" + retain + ",\"needs_release\":" + retain + ",\"is_value\":true,\"is_reference\":false,\"is_copyable\":true,\"has_identity\":false,\"is_comparable\":true,\"is_valid_dict_key\":" + key + "}"
    }
    for type_ in mir_result_types {
        entries = entries + ",{\"tag\":\"result\",\"data\":[" + str(type_.ok) + "," + str(type_.error) + "]}"
        capabilities = capabilities + ",{\"needs_retain\":true,\"needs_release\":true,\"is_value\":true,\"is_reference\":false,\"is_copyable\":true,\"has_identity\":false,\"is_comparable\":false,\"is_valid_dict_key\":false}"
    }
    return "{\"version\":1,\"entries\":" + entries + "],\"capabilities\":" + capabilities + "],\"structs\":{},\"enums\":{},\"interfaces\":{},\"classes\":{}}"
}
