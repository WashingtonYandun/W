fn is_enum_name(name: str) -> bool {
    for e in g_enums {
        if e == name {
            return true
        }
    }
    return false
}

fn is_module_name(name: str) -> bool {
    for m in g_modules {
        if m == name {
            return true
        }
    }
    return false
}

fn c_fn_name(name: str) -> str {
    if g_ns != "" {
        return "wysna_fn_" + g_ns + "__" + name
    }
    return "wysna_fn_" + name
}

fn escape_c_str(s: str) -> str {
    let mut out = "\""
    let n = len(s)
    for i in 0..n {
        let ch = s[i]
        let code = ord(ch)
        if code == 34 {
            out = out + "\\\""
        } elif code == 92 {
            out = out + "\\\\"
        } elif code == 10 {
            out = out + "\\n"
        } elif code == 13 {
            out = out + "\\r"
        } elif code == 9 {
            out = out + "\\t"
        } elif code == 0 {
            out = out + "\\000"
        } elif code == 63 {
            out = out + "\\077"
        } else {
            out = out + ch
        }
    }
    out = out + "\""
    return out
}

fn parsed_unit_return(start: int) -> bool {
    let mut found = false
    for index in start..g_pos {
        let token = g_tokens[index]
        if token.kind == "LPAREN" or token.kind == "RPAREN" { continue }
        if not found and token.kind == "IDENT" and token.val == "unit" { found = true }
        else { return false }
    }
    return found
}

fn parsed_unit_result_return(start: int) -> bool {
    let mut found = false
    for index in start..g_pos {
        let token = g_tokens[index]
        if token.kind == "BANG" { return found }
        if token.kind == "LPAREN" or token.kind == "RPAREN" { continue }
        if not found and token.kind == "IDENT" and token.val == "unit" { found = true }
        else { return false }
    }
    return false
}

fn parse_type_ann() -> bool {
    let mut is_fallible = false
    if match_kind("FN") {
        expect_kind("LPAREN")
        if not check_kind("RPAREN") {
            parse_type_ann()
            while match_kind("COMMA") { parse_type_ann() }
        }
        expect_kind("RPAREN")
        expect_kind("ARROW")
        return parse_type_ann()
    }
    if match_kind("LPAREN") {
        is_fallible = parse_type_ann()
        expect_kind("RPAREN")
    } else {
        let type_token = at_tok()
        advance_tok()
        if type_token.kind == "IDENT" and type_token.val == "Result" { is_fallible = true }
    }
    if match_kind("LBRACKET") {
        while not check_kind("RBRACKET") and not is_eof() {
            parse_type_ann()
            match_kind("COMMA")
        }
        expect_kind("RBRACKET")
    }
    if match_kind("QUESTION") {
        is_fallible = false
    }
    if match_kind("BANG") {
        let err_tok = at_tok()
        parse_type_ann()
        while match_kind("PIPE") { parse_type_ann() }
        is_fallible = true
        g_cur_err_type = err_tok.val
    }
    return is_fallible
}

fn parse_field_default() -> str {
    if check_kind("FN") { parse_type_ann() return "wysna_none()" }
    let tname = at_tok().val
    let mut def_c = "wysna_none()"
    if tname == "Weak" {
        def_c = "wysna_empty_weak()"
    } elif tname == "int" {
        def_c = "wysna_int(0LL)"
    } elif tname == "float" {
        def_c = "wysna_float(0.0)"
    } elif tname == "bool" {
        def_c = "wysna_bool(false)"
    } elif tname == "str" {
        def_c = "wysna_str(\"\")"
    } elif tname == "list" {
        def_c = "wysna_make_list(0, NULL)"
    } elif tname == "dict" {
        def_c = "wysna_make_dict(0, NULL, NULL)"
    }
    advance_tok()
    if match_kind("LBRACKET") {
        while not check_kind("RBRACKET") and not is_eof() {
            parse_type_ann()
            match_kind("COMMA")
        }
        expect_kind("RBRACKET")
    }
    if match_kind("QUESTION") {
        def_c = "wysna_none()"
    }
    return def_c
}

fn find_class_meta_idx(cls_name: str) -> int {
    for i in 0..len(g_classes) {
        if g_classes[i].name == cls_name {
            return i
        }
    }
    return -1
}

fn find_class_method_owner(start_cls: str, m_name: str) -> str {
    let mut cur = start_cls
    while cur != "" {
        let idx = find_class_meta_idx(cur)
        if idx == -1 {
            return ""
        }
        let cm = g_classes[idx]
        for mi in 0..len(cm.method_names) {
            if cm.method_names[mi] == m_name {
                return cm.name
            }
        }
        cur = cm.super_name
    }
    return ""
}

fn find_class_method_arity(start_cls: str, m_name: str) -> int {
    let mut cur = start_cls
    while cur != "" {
        let idx = find_class_meta_idx(cur)
        if idx == -1 {
            return -1
        }
        let cm = g_classes[idx]
        for mi in 0..len(cm.method_names) {
            if cm.method_names[mi] == m_name {
                return cm.method_arities[mi]
            }
        }
        cur = cm.super_name
    }
    return -1
}

fn register_dispatch(m_name: str, arity: int) -> unit {
    for i in 0..len(g_dispatch_names) {
        if g_dispatch_names[i] == m_name and g_dispatch_arities[i] == arity {
            return
        }
    }
    g_dispatch_names.append(m_name)
    g_dispatch_arities.append(arity)
    let mut sig = "WVal v_self"
    for ai in 0..arity {
        sig = sig + ", WVal _a" + str(ai)
    }
    g_protos.append("static WVal wysna_dispatch__" + m_name + "__" + str(arity) + "(" + sig + ");")
}

fn op_precedence(k: str) -> int {
    if k == "ASSIGN" {
        return 1
    }
    if k == "QQ" {
        return 2
    }
    if k == "OR" {
        return 3
    }
    if k == "AND" {
        return 4
    }
    if k == "EQ" or k == "NEQ" or k == "LT" or k == "LTE" or k == "GT" or k == "GTE" {
        return 6
    }
    if k == "DOT_DOT" or k == "DOT_DOT_EQ" {
        return 7
    }
    if k == "PLUS" or k == "MINUS" {
        return 8
    }
    if k == "STAR" or k == "SLASH" or k == "PERCENT" {
        return 9
    }
    return 0
}

fn clean_lref(raw: str) -> str {
    let n = len(raw)
    if n < 2 {
        return raw
    }
    for i in 0..n - 1 {
        if slice(raw, i, i + 2) == "::" {
            return slice(raw, 0, i)
        }
    }
    return raw
}

fn extract_module_ns(path: str) -> str {
    let n = len(path)
    let mut slash = -1
    let mut dot = n
    for i in 0..n {
        if path[i] == "/" {
            slash = i
        } elif path[i] == "." {
            dot = i
        }
    }
    return slice(path, slash + 1, dot)
}

fn bind_call(c_call: str) -> ExprRes {
    let tmp = new_temp()
    declare_owned_var(tmp, c_call)
    return ExprRes { val: tmp, lref: "" }
}
