fn run_compiler() -> unit ! IoError {
    let cli = args()
    if len(cli) > 1 and cli[1] == "--emit-mir" {
        if len(cli) != 3 {
            eprint("[W5002] Usage: Wysna Compiler --emit-mir INPUT")
            exit(2)
        }
        let source = read_file(cli[2])?
        let payload = emit_scalar_mir(source, cli[2])
        print(payload)
        return
    }
    let mut in_path = "selfhost/compiler.wysna"
    let mut out_path = "build/compiler1.c"
    if len(cli) >= 3 {
        in_path = cli[1]
        out_path = cli[2]
    }
    let src = read_file(in_path)?
    check_source(src, in_path)
    let c_code = compile_source(src)
    write_file(out_path, c_code)?
    print("[Wysna Compiler] Compiled", in_path, "->", out_path)
}

let res = run_compiler() else err {
    eprint("[W4003] Wysna Compiler I/O error:", err.message)
    exit(1)
}
