let mut limit = 3
fn first() -> int { print("start")
    return 0
}
fn last() -> int { print("end")
    return limit
}
for index in first()..last() {
    limit = 0
    if index == 1 { continue }
    print(index)
}
for index in 0..100000000 { print("bounded", index)
    break
}
for index in 9223372036854775806..9223372036854775807 { print(index) }
for index in 3..1 { print("unreachable", index) }
let mut values = 1..3
let snapshot = values
values.append(9)
print(values, snapshot)
