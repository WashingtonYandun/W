fn make_list() -> list[str] {
    let mut res: list[str] = []
    let temp1 = "item1"
    let temp2 = "item2"
    res.append(temp1)
    res.append(temp2)
    return res
}

fn main() -> unit {
    let l = make_list()
    print("returned len:", len(l))
    print("first item:", l[0])
    print("second item:", l[1])
}
