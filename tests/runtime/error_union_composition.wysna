import "tests/modules/error_union/errors.wysna"

fn parse_value() -> int ! errors.ParseError {
    return Err(errors.parse_error())
}

fn load_value() -> int ! int {
    return Err(17)
}

fn read_missing() -> int ! errors.FileError {
    return Err(errors.file_error())
}

fn widen_parse_result() -> int ! errors.ParseError | errors.FileError {
    return parse_value()
}

fn parse_or_file(route: int) -> int ! errors.ParseError | errors.FileError {
    if route == 0 {
        return parse_value()?
    }
    return read_missing()?
}

fn combined(route: int) -> int ! errors.ParseError | errors.FileError | int {
    if route == 3 {
        return widen_parse_result()?
    }
    if route == 2 {
        return load_value()?
    }
    return parse_or_file(route)?
}

fn report(route: int) -> int {
    return combined(route) else err {
        match err {
            errors.ParseError(parse_error) => {
                print(parse_error.message)
                0
            },
            errors.FileError(file_error) => {
                print(file_error)
                0
            },
            int(code) => {
                print(code)
                0
            }
        }
    }
}

print(report(0), report(1), report(2), report(3))
print(errors.recover_local())
